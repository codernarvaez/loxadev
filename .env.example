# Copia este archivo a `.env.local` y ajusta valores (desarrollo).
# Creación rápida: cp .env.example .env.local
#
# Create React App solo expone variables que empiezan por REACT_APP_

# --- Firebase (consola del proyecto → Configuración del proyecto → Tus apps) ---
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# --- APIs backend Loxadev (opcional hasta tener URLs definitivas) ---
REACT_APP_API_USERS_URI=
REACT_APP_API_LOXADEV_SITE=
